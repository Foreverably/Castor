{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "rootDir": "",
    "outDir": "./dist",
    "strict": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"], 
      "@/utils/*": ["src/utils/*"],
      "@/structures/*": ["src/structures/*"]
    }
  },
  "include": [
    "src/**/*",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
} 